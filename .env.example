DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kaivaryn?schema=public"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-strong-secret"
# Required in production; Render/Supabase should store this as a secret.
BOOTSTRAP_ADMIN_PASSWORD="change-me-in-production"
STRIPE_PAYMENT_LINK="https://buy.stripe.com/14AaEZgJsdDNeTFePLeUU01"
# SMTP (optional — password reset logs link if unset)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Required to verify Payment Link completion server-side before provisioning
STRIPE_WEBHOOK_SECRET=""
# Protects the provider-neutral acquisition intent ingestion endpoint
ACQUISITION_INGEST_TOKEN=""
# Optional first concrete provider adapter: Clay webhook -> Kaivaryn intent engine
CLAY_WEBHOOK_SECRET=""

# Acquisition execution layer — Google Workspace
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional override; defaults to $NEXTAUTH_URL/api/integrations/google/acquisition/callback
GOOGLE_ACQUISITION_REDIRECT_URI=""
# Dedicated encryption secret for stored OAuth tokens. Falls back to NEXTAUTH_SECRET if omitted.
ACQUISITION_TOKEN_ENCRYPTION_KEY=""
ACQUISITION_SYNC_TOKEN=""
ACQUISITION_AUTOMATION_TOKEN=""
ACQUISITION_DAILY_EMAIL_LIMIT="25"
ACQUISITION_CALL_MAX_TURNS="6"

# Acquisition execution layer — consent-gated AI calls
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
OPENAI_API_KEY=""
OPENAI_CALL_MODEL="gpt-5.6-luna"
