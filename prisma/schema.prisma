// CHIEF Foundry — internal AI agent manufacturer (Kaivaryn executives only)
// =============================================================================

model AgentDefinition {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  description     String?
  kind            String   @default("INTERNAL") // INTERNAL | SECURITY_INTAKE | WORKFORCE | WEB_APP | STATIC_SITE
  status          String   @default("DRAFT") // DRAFT | REGISTERED | DEPRECATED
  ownerRole       String   @default("CEO") // CEO | CSEO | SHARED
  capabilitiesJson String  @default("[]")
  policyJson      String   @default("{}")
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  createdBy   User?           @relation("AgentDefCreator", fields: [createdById], references: [id], onDelete: SetNull)
  versions    AgentVersion[]
  deployments AgentDeployment[]
  executions  AgentExecution[]
  foundryJobs FoundryJob[]
  toolGrants  ToolPermissionGrant[]

  @@index([status])
  @@index([kind])
}

model AgentVersion {
  id               String   @id @default(cuid())
  agentId          String
  version          Int
  changelog        String?
  status           String   @default("STAGED") // STAGED | APPROVED | REJECTED | SUPERSEDED
  packagePath      String?  // relative path under data/agents/
  packageJson      String?  // manifest + source entry
  sourceCode       String?  // sandboxed TS/JSON runner source
  webBundleJson    String?  // { files: { "index.html": "...", ... }, entry, runtime }
  runtime          String   @default("json-runner") // json-runner | static-site | web-app | next-microsite
  architectureJson String   @default("{}")
  toolsJson        String   @default("[]")
  evalSummaryJson  String?
  createdById      String?
  createdAt        DateTime @default(now())

  agent       AgentDefinition   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  createdBy   User?             @relation("AgentVersionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  evalRuns    AgentEvalRun[]
  deployments AgentDeployment[]
  approvals   FoundryApproval[]
  foundryJobs FoundryJob[]

  @@unique([agentId, version])
  @@index([status])
}

model AgentTemplate {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  description     String?
  category        String   @default("INTERNAL")
