generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String
  role          String    @default("VIEWER")
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts               Account[]
  sessions               Session[]
  memberships            Membership[]
  passwordResetTokens    PasswordResetToken[]
  auditLogs              AuditLog[]              @relation("AuditActor")
  assignedOpportunities  Opportunity[]           @relation("OpportunityAssignee")
  opportunityNotes       OpportunityNote[]
  assignedInefficiencies Inefficiency[]          @relation("InefficiencyAssignee")
  inefficiencyNotes      InefficiencyNote[]
  approvalRequests       ApprovalRequest[]       @relation("ApprovalRequester")
  approvalDecisions      ApprovalRequest[]       @relation("ApprovalDecider")
  onboardingProgress     OnboardingProgress[]
  statusChanges          StatusHistory[]         @relation("StatusActor")
  comments               Comment[]
  assignedTasks          Task[]                  @relation("TaskAssignee")
  createdTasks           Task[]                  @relation("TaskCreator")
  notifications          Notification[]
  emailDrafts            EmailDraft[]
  intelligenceRuns       IntelligenceRun[]
  learningEvents         LearningEvent[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  expires   DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships            Membership[]
  entitlements           Entitlement[]
  subscriptions          Subscription[]
  opportunities          Opportunity[]
  inefficiencies         Inefficiency[]
  integrationConnections IntegrationConnection[]
  approvalRequests       ApprovalRequest[]
  onboardingProgress     OnboardingProgress[]
  auditLogs              AuditLog[]
  settings               OrgSettings?
  departments            Department[]
  customers              Customer[]
  contacts               Contact[]
  leads                  Lead[]
  transactions           Transaction[]
  appointments           Appointment[]
  interactions           Interaction[]
  processes              Process[]
  findings               Finding[]
  importJobs             ImportJob[]
  intelligenceRuns       IntelligenceRun[]
  notifications          Notification[]
  tasks                  Task[]
  emailDrafts            EmailDraft[]
  comments               Comment[]
  statusHistories        StatusHistory[]
  evidence               Evidence[]
  learningEvents         LearningEvent[]
  learningProfiles       LearningProfile[]
  acquisitionAccounts    AcquisitionAccount[] @relation("AcquisitionOnboardingOrg")
}

model Membership {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           String   @default("ANALYST")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model OrgSettings {
  id                      String   @id @default(cuid())
  organizationId          String   @unique
  // Detection thresholds (days / counts)
  stalledLeadDays         Int      @default(14)
  dormantCustomerDays     Int      @default(90)
  failedPaymentLookbackDays Int    @default(30)
  missedAppointmentDays   Int      @default(7)
  pipelineStallDays       Int      @default(21)
  churnRiskInactiveDays   Int      @default(60)
  unansweredInquiryHours  Int      @default(48)
  approvalDelayDays       Int      @default(5)
  duplicateWorkWindowDays Int      @default(30)
  // Scoring weights (normalized later)
  scoreWeightAmount       Float    @default(0.35)
  scoreWeightAge          Float    @default(0.2)
  scoreWeightPriority     Float    @default(0.25)
  scoreWeightEvidence     Float    @default(0.2)
  highValueThreshold      Float    @default(50000)
  settingsJson            String?  // extra knobs
  updatedAt               DateTime @updatedAt
  createdAt               DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Department {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  code           String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  processes    Process[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model PricingConfig {
  id                     String   @id @default(cuid())
  key                    String   @unique @default("default")
  introductorySeats      Int      @default(10)
  introductoryPriceCents Int      @default(1000000)
  standardPriceCents     Int      @default(2000000)
  currency               String   @default("USD")
  stripePaymentLink      String
  zoomMeetingUrl         String?  // global Join/schedule Zoom CTA for /demo thank-you
  updatedAt              DateTime @updatedAt
  createdAt              DateTime @default(now())
}

model Subscription {
  id             String    @id @default(cuid())
  organizationId String
  status         String    @default("INACTIVE")
  priceCents     Int
  seatNumber     Int?
  stripeRef      String?
  startedAt      DateTime?
  endsAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Entitlement {
  id             String   @id @default(cuid())
  organizationId String
  product        String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, product])
}

model DemoRequest {
  id          String   @id @default(cuid())
  name        String
  email       String
  company     String
  title       String?
  phone       String?
  products    String
  companySize String?
  message     String?
  zoomLink    String?  // per-lead meeting URL (prospect preferred or admin-scheduled)
  status      String   @default("NEW")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  acquisitionAccount AcquisitionAccount?

  @@index([status])
  @@index([email])
}

model IntegrationConnection {
  id             String    @id @default(cuid())
  organizationId String
  provider       String
  displayName    String
  status         String    @default("AVAILABLE")
  configJson     String?
  lastSyncAt     DateTime?
  errorMessage   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
}

model ApprovalRequest {
  id             String    @id @default(cuid())
  organizationId String
  type           String
  title          String
  description    String?
  status         String    @default("PENDING")
  payloadJson    String?
  needsIntegration String? // e.g. "smtp", "erp_generic" — honest blocker
  requestedById  String
  decidedById    String?
  decidedAt      DateTime?
  decisionNote   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy  User         @relation("ApprovalRequester", fields: [requestedById], references: [id])
  decidedBy    User?        @relation("ApprovalDecider", fields: [decidedById], references: [id])

  @@index([organizationId, status])
}

model OnboardingProgress {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  currentStep    Int       @default(0)
  completedSteps String    @default("[]")
  dataJson       String?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  actorId        String?
  action         String
  entityType     String?
  entityId       String?
  metadataJson   String?
  ip             String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor        User?         @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([createdAt])
  @@index([organizationId, action])
}

model LearningEvent {
  id             String   @id @default(cuid())
  organizationId String
  actorId        String?
  product        String
  entityType     String
  entityId       String
  eventType      String
  outcome        String
  featureJson    String?
  note           String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, product, createdAt])
  @@index([organizationId, entityType, entityId])
}

model LearningProfile {
  id             String   @id @default(cuid())
  organizationId String
  product        String
  sampleSize     Int      @default(0)
  positiveCount  Int      @default(0)
  negativeCount  Int      @default(0)
  confidence     String   @default("LOW")
  profileJson    String   @default("{}")
  lastLearnedAt  DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, product])
  @@index([organizationId, product])
}

// ——— CRM / operational source entities (detection inputs) ———

model Customer {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  email          String?
  status         String    @default("ACTIVE") // ACTIVE | DORMANT | CHURNED
  lastActivityAt DateTime?
  source         String?
  sourceId       String?
  importedAt     DateTime?
  lastSyncAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts     Contact[]
  leads        Lead[]
  transactions Transaction[]
  appointments Appointment[]
  interactions Interaction[]

  @@index([organizationId])
  @@index([organizationId, lastActivityAt])
  @@index([organizationId, source, sourceId])
}

model Contact {
  id             String    @id @default(cuid())
  organizationId String
  customerId     String?
  name           String
  email          String?
  phone          String?
  source         String?
  sourceId       String?
  importedAt     DateTime?
  lastSyncAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([customerId])
}

model Lead {
  id             String    @id @default(cuid())
  organizationId String
  customerId     String?
  title          String
  status         String    @default("OPEN") // OPEN | STALLED | WON | LOST
  stage          String?
  amount         Float     @default(0)
  lastTouchAt    DateTime?
  source         String?
  sourceId       String?
  importedAt     DateTime?
  lastSyncAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([organizationId, lastTouchAt])
}

model Transaction {
  id             String    @id @default(cuid())
  organizationId String
  customerId     String?
  type           String    // PAYMENT | REFUND | INVOICE | CHECKOUT
  status         String    // SUCCEEDED | FAILED | ABANDONED | PENDING
  amount         Float     @default(0)
  currency       String    @default("USD")
  occurredAt     DateTime  @default(now())
  source         String?
  sourceId       String?
  importedAt     DateTime?
  lastSyncAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([organizationId, occurredAt])
}

model Appointment {
  id             String    @id @default(cuid())
  organizationId String
  customerId     String?
  title          String
  status         String    @default("SCHEDULED") // SCHEDULED | COMPLETED | MISSED | CANCELLED
  scheduledAt    DateTime
  source         String?
  sourceId       String?
  importedAt     DateTime?
  lastSyncAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([organizationId, scheduledAt])
}

model Interaction {
  id             String    @id @default(cuid())
  organizationId String
  customerId     String?
  channel        String    // EMAIL | PHONE | CHAT | TICKET
  direction      String    @default("INBOUND")
  subject        String?
  answered       Boolean   @default(false)
  occurredAt     DateTime  @default(now())
  source         String?
  sourceId       String?
  importedAt     DateTime?
  lastSyncAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([organizationId, answered])
  @@index([organizationId, occurredAt])
}

model Process {
  id             String   @id @default(cuid())
  organizationId String
  departmentId   String?
  name           String
  description    String?
  stepsJson      String?  // ordered steps
  ownerRole      String?
  avgCycleDays   Float?
  source         String?
  sourceId       String?
  importedAt     DateTime?
  lastSyncAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department     Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  inefficiencies Inefficiency[]

  @@index([organizationId])
}

// ——— Product work items ———

model Opportunity {
  id               String    @id @default(cuid())
  organizationId   String
  title            String
  description      String?
  source           String?
  sourceId         String?
  importedAt       DateTime?
  lastSyncAt       DateTime?
  department       String?
  type             String?   // detection rule id / underbilling / etc
  status           String    @default("IDENTIFIED")
  priority         String    @default("MEDIUM")
  score            Float     @default(0)
  scoreFactorsJson String?   // explainability for admins
  // Financial recovery fields — estimates ≠ recovered; LLM never sets these
  potentialAmount  Float     @default(0)
  approvedAmount   Float     @default(0)
  inProgressAmount Float     @default(0)
  estimatedAmount  Float     @default(0) // alias of potential for legacy UI
  recoveredAmount  Float     @default(0)
  verifiedAmount   Float     @default(0)
  currency         String    @default("USD")
  assigneeId       String?
  identifiedAt     DateTime  @default(now())
  recoveredAt      DateTime?
  verifiedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignee     User?             @relation("OpportunityAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  notes        OpportunityNote[]
  evidence     Evidence[]
  findings     Finding[]

  @@index([organizationId, status])
  @@index([organizationId, priority])
  @@index([organizationId, identifiedAt])
  @@index([organizationId, score])
  @@index([organizationId, source, sourceId])
}

model OpportunityNote {
  id            String   @id @default(cuid())
  opportunityId String
  authorId      String
  body          String
  createdAt     DateTime @default(now())

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  author      User        @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([opportunityId])
}

model Inefficiency {
  id                   String    @id @default(cuid())
  organizationId       String
  processId            String?
  title                String
  description          String?
  source               String?
  sourceId             String?
  importedAt           DateTime?
  lastSyncAt           DateTime?
  department           String?
  type                 String?
  status               String    @default("IDENTIFIED")
  priority             String    @default("MEDIUM")
  score                Float     @default(0)
  scoreFactorsJson     String?
  estimatedWasteAnnual Float     @default(0) // projected
  projectedSavings     Float     @default(0)
  realizedSavings      Float     @default(0)
  recoveredAnnual      Float     @default(0) // legacy alias of realized
  projectedHoursWeekly Float?
  realizedHoursWeekly  Float?
  hoursWastedWeekly    Float?
  automationCandidate  Boolean   @default(false)
  currency             String    @default("USD")
  assigneeId           String?
  identifiedAt         DateTime  @default(now())
  resolvedAt           DateTime?
  verifiedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  process      Process?           @relation(fields: [processId], references: [id], onDelete: SetNull)
  assignee     User?              @relation("InefficiencyAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  notes        InefficiencyNote[]
  evidence     Evidence[]
  findings     Finding[]

  @@index([organizationId, status])
  @@index([organizationId, priority])
  @@index([organizationId, score])
  @@index([organizationId, source, sourceId])
}

model InefficiencyNote {
  id             String   @id @default(cuid())
  inefficiencyId String
  authorId       String
  body           String
  createdAt      DateTime @default(now())

  inefficiency Inefficiency @relation(fields: [inefficiencyId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([inefficiencyId])
}

model StatusHistory {
  id             String   @id @default(cuid())
  organizationId String
  entityType     String   // Opportunity | Inefficiency | ApprovalRequest
  entityId       String
  fromStatus     String?
  toStatus       String
  note           String?
  actorId        String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation("StatusActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, entityType, entityId])
  @@index([createdAt])
}

model Evidence {
  id               String   @id @default(cuid())
  organizationId   String
  opportunityId    String?
  inefficiencyId   String?
  findingId        String?
  kind             String   @default("FACT") // FACT | METRIC | DOCUMENT | RULE_HIT
  summary          String
  detailJson       String?
  source           String?
  sourceId         String?
  createdAt        DateTime @default(now())

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  opportunity    Opportunity?  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  inefficiency   Inefficiency? @relation(fields: [inefficiencyId], references: [id], onDelete: Cascade)
  finding        Finding?      @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([opportunityId])
  @@index([inefficiencyId])
  @@index([findingId])
}

model Comment {
  id             String   @id @default(cuid())
  organizationId String
  entityType     String
  entityId       String
  authorId       String
  body           String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([organizationId, entityType, entityId])
}

model Finding {
  id               String   @id @default(cuid())
  organizationId   String
  product          String   // REVENUE_RECOVERY | OPERATIONS_EFFICIENCY
  opportunityId    String?
  inefficiencyId   String?
  status           String   @default("OPEN") // OPEN | ACCEPTED | REJECTED | INSUFFICIENT_DATA
  // Evidence | Analysis | Recommendation | Decision
  evidenceSummary  String?
  analysis         String?
  recommendation   String?
  decision         String?
  confidence       String   @default("low")
  explainJson      String?  // factors, rule ids, signals
  ruleId           String?
  impactEstimate   Float?   // from financial engine — not LLM
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  opportunity    Opportunity?  @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  inefficiency   Inefficiency? @relation(fields: [inefficiencyId], references: [id], onDelete: SetNull)
  evidence       Evidence[]

  @@index([organizationId, product])
  @@index([organizationId, status])
}

model ImportJob {
  id             String    @id @default(cuid())
  organizationId String
  kind           String    // opportunities | customers | processes | inefficiencies
  status         String    @default("QUEUED") // QUEUED | RUNNING | SUCCEEDED | FAILED
  fileName       String?
  mappingJson    String?
  errorJson      String?
  rowCount       Int       @default(0)
  successCount   Int       @default(0)
  errorCount     Int       @default(0)
  createdById    String?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([createdAt])
}

model IntelligenceRun {
  id             String    @id @default(cuid())
  organizationId String
  product        String?
  status         String    @default("QUEUED")
  resultJson     String?
  findingCount   Int       @default(0)
  createdById    String?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
}

model Notification {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  title          String
  body           String?
  href           String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([organizationId])
}

model Task {
  id             String    @id @default(cuid())
  organizationId String
  title          String
  body           String?
  entityType     String?
  entityId       String?
  status         String    @default("OPEN") // OPEN | DONE | CANCELLED
  dueAt          DateTime?
  assigneeId     String?
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignee     User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy    User         @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([assigneeId])
}

model EmailDraft {
  id             String   @id @default(cuid())
  organizationId String
  entityType     String?
  entityId       String?
  toAddress      String?
  subject        String
  body           String
  status         String   @default("DRAFT") // DRAFT only — never fake send
  createdById    String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model AcquisitionAccount {
  id                       String    @id @default(cuid())
  company                  String
  domain                   String?   @unique
  website                  String?
  industry                 String?
  companySize              String?
  estimatedRevenue         Float?
  location                 String?
  stage                    String    @default("DETECTED")
  source                   String?
  primaryName              String?
  primaryEmail             String?
  primaryTitle             String?
  phone                    String?
  intentScore              Int       @default(0)
  qualificationScore       Int       @default(0)
  qualificationBand        String    @default("UNSCORED")
  painSummary              String?
  economicHypothesis       String?
  secondaryQualificationJson String?
  objectionsJson           String    @default("[]")
  stakeholdersJson         String    @default("[]")
  nextAction               String?
  demoOutcome              String?
  demoNotes                String?
  lossReason               String?
  winReason                String?
  selectedProduct          String?
  estimatedDealValueCents  Int?
  demoRequestId            String?   @unique
  demoCompletedAt          DateTime?
  checkoutToken            String?   @unique
  checkoutReadyAt          DateTime?
  paymentStatus            String    @default("NOT_READY")
  stripeRef                String?
  paidAt                   DateTime?
  onboardingOrganizationId String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  demoRequest            DemoRequest?            @relation(fields: [demoRequestId], references: [id], onDelete: SetNull)
  onboardingOrganization Organization?           @relation("AcquisitionOnboardingOrg", fields: [onboardingOrganizationId], references: [id], onDelete: SetNull)
  contacts               AcquisitionContact[]
  intentSignals          IntentSignal[]
  qualificationSnapshots QualificationSnapshot[]
  research               AccountResearch?
  microAudits            MicroAudit[]
  outreachMessages       OutreachMessage[]
  activities             AcquisitionActivity[]
  paymentEvents          PaymentEvent[]
  calls                  AcquisitionCall[]
  inboundEvents          AcquisitionInboundEvent[]

  @@index([domain])
  @@index([primaryEmail])
  @@index([stage])
  @@index([qualificationBand])
  @@index([paymentStatus])
  @@index([createdAt])
}

model AcquisitionContact {
  id             String   @id @default(cuid())
  accountId      String
  name           String?
  email          String?
  title          String?
  phone          String?
  publicProfile  String?
  authorityScore Int      @default(0)
  isPrimary      Boolean  @default(false)
  source         String?
  verified       Boolean  @default(false)
  timezone       String?
  phoneConsentAt DateTime?
  phoneConsentSource String?
  doNotCallAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  account          AcquisitionAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  outreachMessages OutreachMessage[]
  calls            AcquisitionCall[]
  inboundEvents    AcquisitionInboundEvent[]

  @@unique([accountId, email])
  @@index([accountId])
  @@index([email])
}

model IntentSignal {
  id         String   @id @default(cuid())
  accountId  String
  fingerprint String  @unique
  type       String
  category   String
  source     String
  sourceUrl  String?
  evidence   String?
  strength   Int      @default(50)
  confidence Int      @default(50)
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  account AcquisitionAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, occurredAt])
  @@index([category])
  @@index([source])
}

model QualificationSnapshot {
  id                  String   @id @default(cuid())
  accountId           String
  icpFit              Int
  intentStrength      Int
  painOpportunity     Int
  economicValue       Int
  decisionMakerAccess Int
  timingUrgency       Int
  total               Int
  band                String
  reasoningJson       String
  version             String   @default("v1")
  createdAt           DateTime @default(now())

  account AcquisitionAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
  @@index([band])
}

model AccountResearch {
  id                   String   @id @default(cuid())
  accountId            String   @unique
  status               String   @default("DRAFT")
  businessModel        String?
  revenueModel         String?
  verifiedFactsJson    String   @default("[]")
  hypothesesJson       String   @default("[]")
  techStackJson        String   @default("[]")
  painHypothesesJson   String   @default("[]")
  evidenceJson         String   @default("[]")
  researchedAt         DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  account AcquisitionAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model MicroAudit {
  id                      String    @id @default(cuid())
  accountId               String
  status                  String    @default("DRAFT")
  observation             String
  evidenceSummary         String
  economicHypothesis      String
  diagnosticQuestionsJson String    @default("[]")
  recommendedIntervention String?
  reverseSellMessage      String
  approvedAt              DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  account AcquisitionAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
  @@index([status])
}

model OutreachMessage {
  id             String    @id @default(cuid())
  accountId      String
  contactId      String?
  channel        String    @default("EMAIL")
  subject        String?
  body           String
  status         String    @default("DRAFT")
  providerRef    String?
  scheduledAt    DateTime?
  sentAt         DateTime?
  repliedAt      DateTime?
  responseClass  String?
  responseJson   String?
  optedOutAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  account AcquisitionAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contact AcquisitionContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([accountId, status])
  @@index([contactId])
  @@index([scheduledAt])
}


model AcquisitionProviderConnection {
  id                    String    @id @default(cuid())
  provider              String    @unique
  status                String    @default("DISCONNECTED")
  accountLabel          String?
  accessTokenEncrypted  String?
  refreshTokenEncrypted String?
  expiresAt             DateTime?
  scopes                 String?
  syncCursor             String?
  lastSyncAt             DateTime?
  lastError              String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([status])
}

model AcquisitionInboundEvent {
  id              String   @id @default(cuid())
  provider        String
  providerEventId String
  accountId       String
  contactId       String?
  channel         String   @default("EMAIL")
  sender          String?
  subject         String?
  body            String
  responseClass   String?
  receivedAt      DateTime
  createdAt       DateTime @default(now())

  account AcquisitionAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contact AcquisitionContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@unique([provider, providerEventId])
  @@index([accountId, receivedAt])
  @@index([contactId])
}

model AcquisitionCall {
  id             String    @id @default(cuid())
  accountId      String
  contactId      String?
  provider       String    @default("TWILIO")
  providerCallId String?   @unique
  direction      String    @default("OUTBOUND")
  status         String    @default("QUEUED")
  fromNumber     String?
  toNumber       String
  consentBasis   String
  scriptVersion  String    @default("exec-v1")
  turnsJson      String    @default("[]")
  summary        String?
  disposition    String?
  startedAt      DateTime?
  endedAt        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  account AcquisitionAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contact AcquisitionContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([accountId, createdAt])
  @@index([contactId, createdAt])
  @@index([status])
}

model AcquisitionActivity {
  id        String   @id @default(cuid())
  accountId String
  type      String
  summary   String
  dataJson  String?
  createdAt DateTime @default(now())

  account AcquisitionAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
  @@index([type])
}

model PaymentEvent {
  id                   String   @id @default(cuid())
  accountId            String
  eventId              String   @unique
  type                 String
  amountCents          Int?
  currency             String?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  createdAt            DateTime @default(now())

  account AcquisitionAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
}
