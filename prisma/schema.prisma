}

model AgentDeployment {
  id            String    @id @default(cuid())
  agentId       String
  versionId     String
  environment   String    @default("STAGING") // STAGING | PRODUCTION
  status        String    @default("PENDING") // PENDING | ACTIVE | ROLLED_BACK | FAILED
