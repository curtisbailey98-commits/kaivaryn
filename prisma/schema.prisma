generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}












model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String
  role          String      @default("VIEWER") // platform-level; SUPER_ADMIN only for Kaivaryn staff
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts           Account[]
  sessions           Session[]
  memberships        Membership[]
  passwordResetTokens PasswordResetToken[]
  auditLogs          AuditLog[]            @relation("AuditActor")
  assignedOpportunities Opportunity[]     @relation("OpportunityAssignee")
  opportunityNotes   OpportunityNote[]
  assignedInefficiencies Inefficiency[]   @relation("InefficiencyAssignee")
  inefficiencyNotes  InefficiencyNote[]
  approvalRequests   ApprovalRequest[]    @relation("ApprovalRequester")
  approvalDecisions  ApprovalRequest[]    @relation("ApprovalDecider")
  onboardingProgress OnboardingProgress[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expires   DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  isDemo      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships            Membership[]
  entitlements           Entitlement[]
  subscriptions          Subscription[]
  opportunities          Opportunity[]
  inefficiencies         Inefficiency[]
  integrationConnections IntegrationConnection[]
  approvalRequests       ApprovalRequest[]
  onboardingProgress     OnboardingProgress[]
  auditLogs              AuditLog[]
}

model Membership {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           String     @default("ANALYST")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model PricingConfig {
  id                    String   @id @default(cuid())
  key                   String   @unique @default("default")
  introductorySeats     Int      @default(10)
  introductoryPriceCents Int     @default(1000000) // $10,000
  standardPriceCents    Int      @default(2000000) // $20,000
  currency              String   @default("USD")
  stripePaymentLink     String
  updatedAt             DateTime @updatedAt
  createdAt             DateTime @default(now())
}

model Subscription {
  id             String             @id @default(cuid())
  organizationId String
  status         String @default("INACTIVE")
  priceCents     Int
  seatNumber     Int? // which seat in the introductory pool
  stripeRef      String?
  startedAt      DateTime?
  endsAt         DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Entitlement {
  id             String   @id @default(cuid())
  organizationId String
  product        String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, product])
}

model DemoRequest {
  id          String            @id @default(cuid())
  name        String
  email       String
  company     String
  title       String?
  phone       String?
  products    String            // comma-separated or JSON
  companySize String?
  message     String?
  status      String @default("NEW")
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([status])
  @@index([email])
}

model IntegrationConnection {
  id             String            @id @default(cuid())
  organizationId String
  provider       String
  displayName    String
  status         String @default("AVAILABLE")
  configJson     String?           // non-secret config only
  lastSyncAt     DateTime?
  errorMessage   String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
}

model ApprovalRequest {
  id             String         @id @default(cuid())
  organizationId String
  type           String
  title          String
  description    String?
  status         String @default("PENDING")
  payloadJson    String?        // proposed action details — never auto-executed externally
  requestedById  String
  decidedById    String?
  decidedAt      DateTime?
  decisionNote   String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy  User         @relation("ApprovalRequester", fields: [requestedById], references: [id])
  decidedBy    User?        @relation("ApprovalDecider", fields: [decidedById], references: [id])

  @@index([organizationId, status])
}

model OnboardingProgress {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  currentStep    Int      @default(0)
  completedSteps String   @default("[]") // JSON array of step ids
  dataJson       String?  // wizard answers
  completedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  actorId        String?
  action         String
  entityType     String?
  entityId       String?
  metadataJson   String?
  ip             String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor        User?         @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([createdAt])
}

model Opportunity {
  id              String               @id @default(cuid())
  organizationId  String
  title           String
  description     String?
  source          String?
  department      String?
  type            String?
  status          String    @default("NEW")
  priority        String  @default("MEDIUM")
  estimatedAmount Float                @default(0)
  recoveredAmount Float                @default(0)
  currency        String               @default("USD")
  assigneeId      String?
  identifiedAt    DateTime             @default(now())
  recoveredAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignee     User?             @relation("OpportunityAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  notes        OpportunityNote[]

  @@index([organizationId, status])
  @@index([organizationId, priority])
  @@index([organizationId, identifiedAt])
}

model OpportunityNote {
  id            String   @id @default(cuid())
  opportunityId String
  authorId      String
  body          String
  createdAt     DateTime @default(now())

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  author      User        @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([opportunityId])
}

model Inefficiency {
  id                 String                @id @default(cuid())
  organizationId     String
  title              String
  description        String?
  source             String?
  department         String?
  type               String?
  status             String    @default("NEW")
  priority           String  @default("MEDIUM")
  estimatedWasteAnnual Float               @default(0)
  recoveredAnnual    Float                 @default(0)
  hoursWastedWeekly  Float?
  automationCandidate Boolean              @default(false)
  currency           String                @default("USD")
  assigneeId         String?
  identifiedAt       DateTime              @default(now())
  resolvedAt         DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignee     User?              @relation("InefficiencyAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  notes        InefficiencyNote[]

  @@index([organizationId, status])
  @@index([organizationId, priority])
}

model InefficiencyNote {
  id             String   @id @default(cuid())
  inefficiencyId String
  authorId       String
  body           String
  createdAt      DateTime @default(now())

  inefficiency Inefficiency @relation(fields: [inefficiencyId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([inefficiencyId])
}
