generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String
  role          String    @default("VIEWER")
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts               Account[]
  sessions               Session[]
  memberships            Membership[]
  passwordResetTokens    PasswordResetToken[]
  auditLogs              AuditLog[]              @relation("AuditActor")
  assignedOpportunities  Opportunity[]           @relation("OpportunityAssignee")
  opportunityNotes       OpportunityNote[]
  assignedInefficiencies Inefficiency[]          @relation("InefficiencyAssignee")
  inefficiencyNotes      InefficiencyNote[]
  approvalRequests       ApprovalRequest[]       @relation("ApprovalRequester")
  approvalDecisions      ApprovalRequest[]       @relation("ApprovalDecider")
  onboardingProgress     OnboardingProgress[]
  statusChanges          StatusHistory[]         @relation("StatusActor")
  comments               Comment[]
  assignedTasks          Task[]                  @relation("TaskAssignee")
  createdTasks           Task[]                  @relation("TaskCreator")
  notifications          Notification[]
  emailDrafts            EmailDraft[]
  intelligenceRuns       IntelligenceRun[]
  learningEvents         LearningEvent[]

  assignedProspectAccounts ProspectAccount[]  @relation("ProspectAssignee")
  microAuditsCreated       MicroAudit[]       @relation("MicroAuditCreator")
  sequencesCreated         OutreachSequence[] @relation("SequenceCreator")
  outreachMessagesCreated  OutreachMessage[]  @relation("OutreachMessageCreator")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  expires   DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  isDemo    Boolean  @default(false)
  isPlatform Boolean @default(false) // the one internal "Kaivaryn" org that hosts acquisition-system rows — excluded from client-org listings
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships            Membership[]
  entitlements           Entitlement[]
  subscriptions          Subscription[]
  opportunities          Opportunity[]
  inefficiencies         Inefficiency[]
  integrationConnections IntegrationConnection[]
  approvalRequests       ApprovalRequest[]
  onboardingProgress     OnboardingProgress[]
  auditLogs              AuditLog[]
  settings               OrgSettings?
  departments            Department[]
  customers              Customer[]
  contacts               Contact[]
  leads                  Lead[]
  transactions           Transaction[]
  appointments           Appointment[]
  interactions           Interaction[]
  processes              Process[]
  findings               Finding[]
  importJobs             ImportJob[]
  intelligenceRuns       IntelligenceRun[]
  notifications          Notification[]
  tasks                  Task[]
  emailDrafts            EmailDraft[]
  comments               Comment[]
  statusHistories        StatusHistory[]
  evidence               Evidence[]
  learningEvents         LearningEvent[]
  learningProfiles       LearningProfile[]

  originatingProspectAccount ProspectAccount?
}

model Membership {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           String   @default("ANALYST")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model OrgSettings {
  id                      String   @id @default(cuid())
  organizationId          String   @unique
  // Detection thresholds (days / counts)
  stalledLeadDays         Int      @default(14)
  dormantCustomerDays     Int      @default(90)
  failedPaymentLookbackDays Int    @default(30)
  missedAppointmentDays   Int      @default(7)
  pipelineStallDays       Int      @default(21)
  churnRiskInactiveDays   Int      @default(60)
  unansweredInquiryHours  Int      @default(48)
  approvalDelayDays       Int      @default(5)
  duplicateWorkWindowDays Int      @default(30)
  // Scoring weights (normalized later)
  scoreWeightAmount       Float    @default(0.35)
  scoreWeightAge          Float    @default(0.2)
  scoreWeightPriority     Float    @default(0.25)
  scoreWeightEvidence     Float    @default(0.2)
  highValueThreshold      Float    @default(50000)
  settingsJson            String?  // extra knobs
  updatedAt               DateTime @updatedAt
  createdAt               DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Department {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  code           String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  processes    Process[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model PricingConfig {
  id                     String   @id @default(cuid())
  key                    String   @unique @default("default")
  introductorySeats      Int      @default(10)
  introductoryPriceCents Int      @default(1000000)
  standardPriceCents     Int      @default(2000000)
  currency               String   @default("USD")
  stripePaymentLink      String
  zoomMeetingUrl         String?  // global Join/schedule Zoom CTA for /demo thank-you
  updatedAt              DateTime @updatedAt
  createdAt              DateTime @default(now())
}

model Subscription {
  id             String    @id @default(cuid())
  organizationId String
  status         String    @default("INACTIVE")
  priceCents     Int
  seatNumber     Int?
  stripeRef      String?
  stripeCustomerId String?
  startedAt      DateTime?
  endsAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Entitlement {
  id             String   @id @default(cuid())
  organizationId String
  product        String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, product])
}

model DemoRequest {
  id          String   @id @default(cuid())
  name        String
  email       String
  company     String
  title       String?
  phone       String?
  products    String
  companySize String?
  message     String?
  zoomLink    String?  // per-lead meeting URL (prospect preferred or admin-scheduled)
  status      String   @default("NEW")
  notes       String?
  prospectAccountId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  prospectAccount ProspectAccount? @relation(fields: [prospectAccountId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([email])
  @@index([prospectAccountId])
}

model IntegrationConnection {
  id             String    @id @default(cuid())
  organizationId String
  provider       String
  displayName    String
  status         String    @default("AVAILABLE")
  configJson     String?
  lastSyncAt     DateTime?
  errorMessage   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
}

model ApprovalRequest {
  id             String    @id @default(cuid())
  organizationId String
  type           String
  title          String
  description    String?
  status         String    @default("PENDING")
  payloadJson    String?
  needsIntegration String? // e.g. "smtp", "erp_generic" — honest blocker
  requestedById  String
  decidedById    String?
  decidedAt      DateTime?
  decisionNote   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy  User         @relation("ApprovalRequester", fields: [requestedById], references: [id])
  decidedBy    User?        @relation("ApprovalDecider", fields: [decidedById], references: [id])

  @@index([organizationId, status])
}

model OnboardingProgress {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  currentStep    Int       @default(0)
  completedSteps String    @default("[]")
  dataJson       String?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  actorId        String?
  action         String
  entityType     String?
  entityId       String?
  metadataJson   String?
  ip             String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor        User?         @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([createdAt])
  @@index([organizationId, action])
}

model LearningEvent {
  id             String   @id @default(cuid())
  organizationId String
  actorId        String?
  product        String
  entityType     String
  entityId       String
  eventType      String
  outcome        String
  featureJson    String?
  note           String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, product, createdAt])
  @@index([organizationId, entityType, entityId])
}

model LearningProfile {
  id             String   @id @default(cuid())
  organizationId String
  product        String
  sampleSize     Int      @default(0)
  positiveCount  Int      @default(0)
  negativeCount  Int      @default(0)
  confidence     String   @default("LOW")
  profileJson    String   @default("{}")
  lastLearnedAt  DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, product])
  @@index([organizationId, product])
}

// ——— CRM / operational source entities (detection inputs) ———

model Customer {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  email          String?
  status         String    @default("ACTIVE") // ACTIVE | DORMANT | CHURNED
  lastActivityAt DateTime?
  source         String?
  sourceId       String?
  importedAt     DateTime?
  lastSyncAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts     Contact[]
  leads        Lead[]
  transactions Transaction[]
  appointments Appointment[]
  interactions Interaction[]

  @@index([organizationId])
  @@index([organizationId, lastActivityAt])
  @@index([organizationId, source, sourceId])
}

model Contact {
  id             String    @id @default(cuid())
  organizationId String
  customerId     String?
  name           String
  email          String?
  phone          String?
  source         String?
  sourceId       String?
  importedAt     DateTime?
  lastSyncAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([customerId])
}

model Lead {
  id             String    @id @default(cuid())
  organizationId String
  customerId     String?
  title          String
  status         String    @default("OPEN") // OPEN | STALLED | WON | LOST
  stage          String?
  amount         Float     @default(0)
  lastTouchAt    DateTime?
  source         String?
  sourceId       String?
  importedAt     DateTime?
  lastSyncAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([organizationId, lastTouchAt])
}

model Transaction {
  id             String    @id @default(cuid())
  organizationId String
  customerId     String?
  type           String    // PAYMENT | REFUND | INVOICE | CHECKOUT
  status         String    // SUCCEEDED | FAILED | ABANDONED | PENDING
  amount         Float     @default(0)
  currency       String    @default("USD")
  occurredAt     DateTime  @default(now())
  source         String?
  sourceId       String?
  importedAt     DateTime?
  lastSyncAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([organizationId, occurredAt])
}

model Appointment {
  id             String    @id @default(cuid())
  organizationId String
  customerId     String?
  title          String
  status         String    @default("SCHEDULED") // SCHEDULED | COMPLETED | MISSED | CANCELLED
  scheduledAt    DateTime
  source         String?
  sourceId       String?
  importedAt     DateTime?
  lastSyncAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([organizationId, scheduledAt])
}

model Interaction {
  id             String    @id @default(cuid())
  organizationId String
  customerId     String?
  channel        String    // EMAIL | PHONE | CHAT | TICKET
  direction      String    @default("INBOUND")
  subject        String?
  answered       Boolean   @default(false)
  occurredAt     DateTime  @default(now())
  source         String?
  sourceId       String?
  importedAt     DateTime?
  lastSyncAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([organizationId, answered])
  @@index([organizationId, occurredAt])
}

model Process {
  id             String   @id @default(cuid())
  organizationId String
  departmentId   String?
  name           String
  description    String?
  stepsJson      String?  // ordered steps
  ownerRole      String?
  avgCycleDays   Float?
  source         String?
  sourceId       String?
  importedAt     DateTime?
  lastSyncAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department     Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  inefficiencies Inefficiency[]

  @@index([organizationId])
}

// ——— Product work items ———

model Opportunity {
  id               String    @id @default(cuid())
  organizationId   String
  title            String
  description      String?
  source           String?
  sourceId         String?
  importedAt       DateTime?
  lastSyncAt       DateTime?
  department       String?
  type             String?   // detection rule id / underbilling / etc
  status           String    @default("IDENTIFIED")
  priority         String    @default("MEDIUM")
  score            Float     @default(0)
  scoreFactorsJson String?   // explainability for admins
  // Financial recovery fields — estimates ≠ recovered; LLM never sets these
  potentialAmount  Float     @default(0)
  approvedAmount   Float     @default(0)
  inProgressAmount Float     @default(0)
  estimatedAmount  Float     @default(0) // alias of potential for legacy UI
  recoveredAmount  Float     @default(0)
  verifiedAmount   Float     @default(0)
  currency         String    @default("USD")
  assigneeId       String?
  identifiedAt     DateTime  @default(now())
  recoveredAt      DateTime?
  verifiedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignee     User?             @relation("OpportunityAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  notes        OpportunityNote[]
  evidence     Evidence[]
  findings     Finding[]

  @@index([organizationId, status])
  @@index([organizationId, priority])
  @@index([organizationId, identifiedAt])
  @@index([organizationId, score])
  @@index([organizationId, source, sourceId])
}

model OpportunityNote {
  id            String   @id @default(cuid())
  opportunityId String
  authorId      String
  body          String
  createdAt     DateTime @default(now())

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  author      User        @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([opportunityId])
}

model Inefficiency {
  id                   String    @id @default(cuid())
  organizationId       String
  processId            String?
  title                String
  description          String?
  source               String?
  sourceId             String?
  importedAt           DateTime?
  lastSyncAt           DateTime?
  department           String?
  type                 String?
  status               String    @default("IDENTIFIED")
  priority             String    @default("MEDIUM")
  score                Float     @default(0)
  scoreFactorsJson     String?
  estimatedWasteAnnual Float     @default(0) // projected
  projectedSavings     Float     @default(0)
  realizedSavings      Float     @default(0)
  recoveredAnnual      Float     @default(0) // legacy alias of realized
  projectedHoursWeekly Float?
  realizedHoursWeekly  Float?
  hoursWastedWeekly    Float?
  automationCandidate  Boolean   @default(false)
  currency             String    @default("USD")
  assigneeId           String?
  identifiedAt         DateTime  @default(now())
  resolvedAt           DateTime?
  verifiedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  process      Process?           @relation(fields: [processId], references: [id], onDelete: SetNull)
  assignee     User?              @relation("InefficiencyAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  notes        InefficiencyNote[]
  evidence     Evidence[]
  findings     Finding[]

  @@index([organizationId, status])
  @@index([organizationId, priority])
  @@index([organizationId, score])
  @@index([organizationId, source, sourceId])
}

model InefficiencyNote {
  id             String   @id @default(cuid())
  inefficiencyId String
  authorId       String
  body           String
  createdAt      DateTime @default(now())

  inefficiency Inefficiency @relation(fields: [inefficiencyId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([inefficiencyId])
}

model StatusHistory {
  id             String   @id @default(cuid())
  organizationId String
  entityType     String   // Opportunity | Inefficiency | ApprovalRequest
  entityId       String
  fromStatus     String?
  toStatus       String
  note           String?
  actorId        String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation("StatusActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, entityType, entityId])
  @@index([createdAt])
}

model Evidence {
  id               String   @id @default(cuid())
  organizationId   String
  opportunityId    String?
  inefficiencyId   String?
  findingId        String?
  prospectAccountId String? // acquisition-system evidence (organizationId = platform org)
  kind             String   @default("FACT") // FACT | METRIC | DOCUMENT | RULE_HIT
  summary          String
  detailJson       String?
  source           String?
  sourceId         String?
  createdAt        DateTime @default(now())

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  opportunity     Opportunity?     @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  inefficiency    Inefficiency?    @relation(fields: [inefficiencyId], references: [id], onDelete: Cascade)
  finding         Finding?         @relation(fields: [findingId], references: [id], onDelete: Cascade)
  prospectAccount ProspectAccount? @relation(fields: [prospectAccountId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([opportunityId])
  @@index([inefficiencyId])
  @@index([prospectAccountId])
  @@index([findingId])
}

model Comment {
  id             String   @id @default(cuid())
  organizationId String
  entityType     String
  entityId       String
  authorId       String
  body           String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([organizationId, entityType, entityId])
}

model Finding {
  id               String   @id @default(cuid())
  organizationId   String
  product          String   // REVENUE_RECOVERY | OPERATIONS_EFFICIENCY | CLIENT_ACQUISITION
  opportunityId    String?
  inefficiencyId   String?
  prospectAccountId String? // acquisition pain/opportunity hypotheses (organizationId = platform org); ruleId doubles as pain category
  status           String   @default("OPEN") // OPEN | ACCEPTED | REJECTED | INSUFFICIENT_DATA
  // Evidence | Analysis | Recommendation | Decision
  evidenceSummary  String?
  analysis         String?
  recommendation   String?
  decision         String?
  confidence       String   @default("low")
  explainJson      String?  // factors, rule ids, signals
  ruleId           String?
  impactEstimate   Float?   // from financial engine — not LLM
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  opportunity     Opportunity?     @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  inefficiency    Inefficiency?    @relation(fields: [inefficiencyId], references: [id], onDelete: SetNull)
  prospectAccount ProspectAccount? @relation(fields: [prospectAccountId], references: [id], onDelete: SetNull)
  evidence        Evidence[]

  @@index([organizationId, product])
  @@index([organizationId, status])
  @@index([prospectAccountId])
}

model ImportJob {
  id             String    @id @default(cuid())
  organizationId String
  kind           String    // opportunities | customers | processes | inefficiencies
  status         String    @default("QUEUED") // QUEUED | RUNNING | SUCCEEDED | FAILED
  fileName       String?
  mappingJson    String?
  errorJson      String?
  rowCount       Int       @default(0)
  successCount   Int       @default(0)
  errorCount     Int       @default(0)
  createdById    String?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([createdAt])
}

model IntelligenceRun {
  id             String    @id @default(cuid())
  organizationId String
  product        String?
  status         String    @default("QUEUED")
  resultJson     String?
  findingCount   Int       @default(0)
  createdById    String?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
}

model Notification {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  title          String
  body           String?
  href           String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([organizationId])
}

model Task {
  id             String    @id @default(cuid())
  organizationId String
  title          String
  body           String?
  entityType     String?
  entityId       String?
  status         String    @default("OPEN") // OPEN | DONE | CANCELLED
  dueAt          DateTime?
  assigneeId     String?
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignee     User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy    User         @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([assigneeId])
}

model EmailDraft {
  id             String   @id @default(cuid())
  organizationId String
  entityType     String?
  entityId       String?
  toAddress      String?
  subject        String
  body           String
  status         String   @default("DRAFT") // DRAFT only — never fake send
  createdById    String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// =========================================================================
// CLIENT ACQUISITION INTELLIGENCE SYSTEM
// Platform-level (no organizationId) — Kaivaryn's own sales engine, not a
// tenant-facing product. See docs/kaivaryn-acquisition-implementation-package.md
// =========================================================================

model AcquisitionSettings {
  id                        String   @id @default(cuid())
  key                       String   @unique @default("default")
  weightIcpFit              Float    @default(0.25)
  weightIntent              Float    @default(0.25)
  weightPain                Float    @default(0.20)
  weightEconomicValue       Float    @default(0.15)
  weightDecisionMakerAccess Float    @default(0.10)
  weightTiming              Float    @default(0.05)
  priorityThreshold         Float    @default(75)
  nurtureThreshold          Float    @default(55)
  icpMinEmployees           Int      @default(20)
  icpMaxEmployees           Int      @default(500)
  icpMinRevenueUsd          Float    @default(2000000)
  icpMaxRevenueUsd          Float    @default(75000000)
  updatedAt                 DateTime @updatedAt
  createdAt                 DateTime @default(now())
}

model IntentSignal {
  id                String    @id @default(cuid())
  companyName       String
  domain            String?
  signalType        String
  signalCategory    String
  source            String
  sourceId          String?
  sourceUrl         String?
  detectedAt        DateTime  @default(now())
  confidence        String    @default("low")
  strength          Float     @default(0)
  reasoning         String?
  rawDataJson       String?
  status            String    @default("NEW")
  prospectAccountId String?
  createdAt         DateTime  @default(now())

  prospectAccount ProspectAccount? @relation(fields: [prospectAccountId], references: [id], onDelete: SetNull)

  @@unique([source, sourceId])
  @@index([status])
  @@index([domain])
  @@index([prospectAccountId])
}

model ProspectAccount {
  id                       String    @id @default(cuid())
  name                     String
  domain                   String?   @unique
  industry                 String?
  employeeCountEstimate    Int?
  estimatedRevenueUsd      Float?
  location                 String?
  technologyStackJson      String?
  description              String?
  status                   String    @default("DETECTED")
  priority                 String    @default("MEDIUM")
  intentScore              Float     @default(0)
  qualificationScore       Float     @default(0)
  qualificationFactorsJson String?
  estimatedDealValueCents  Int?
  incumbentSolution        String?
  stakeholdersJson         String?
  objectionsJson           String?
  lossReason               String?
  winReason                String?
  expectedCloseAt          DateTime?
  disqualifiedReason       String?
  nurtureUntil             DateTime?
  demoScheduledAt          DateTime?
  demoCompletedAt          DateTime?
  qualifiedToBuyAt         DateTime?
  checkoutReadyAt          DateTime?
  checkoutStartedAt        DateTime?
  paymentSucceededAt       DateTime?
  source                   String?
  sourceId                 String?
  assigneeId               String?
  wonOrganizationId        String?   @unique
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  assignee        User?                 @relation("ProspectAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  wonOrganization Organization?         @relation(fields: [wonOrganizationId], references: [id], onDelete: SetNull)
  contacts        ProspectContact[]
  intentSignals   IntentSignal[]
  research        AccountResearch?
  microAudits     MicroAudit[]
  sequences       OutreachSequence[]
  demoRequests    DemoRequest[]
  // Pain/opportunity hypotheses and their supporting evidence reuse the
  // existing Finding/Evidence tables (product: "CLIENT_ACQUISITION",
  // organizationId: the platform org) rather than parallel models —
  // see prospectAccountId on Finding/Evidence above.
  findings        Finding[]
  evidence        Evidence[]

  @@index([status])
  @@index([priority])
  @@index([qualificationScore])
  @@index([source, sourceId])
}

model ProspectContact {
  id                String   @id @default(cuid())
  prospectAccountId String
  name              String
  title             String?
  seniorityRole     String?
  email             String?
  phone             String?
  linkedinUrl       String?
  isEconomicBuyer   Boolean  @default(false)
  source            String?
  sourceId          String?
  createdAt         DateTime @default(now())

  prospectAccount ProspectAccount    @relation(fields: [prospectAccountId], references: [id], onDelete: Cascade)
  sequences       OutreachSequence[]
  replies         ReplyRecord[]

  @@index([prospectAccountId])
  @@unique([prospectAccountId, email])
}

model AccountResearch {
  id                  String   @id @default(cuid())
  prospectAccountId   String   @unique
  summary             String?
  verifiedFactsJson   String?
  recentEventsJson    String?
  status              String   @default("INSUFFICIENT_DATA")
  requiredSignalsJson String?
  generatedAt         DateTime @default(now())
  updatedAt           DateTime @updatedAt

  prospectAccount ProspectAccount @relation(fields: [prospectAccountId], references: [id], onDelete: Cascade)
}

model MicroAudit {
  id                String    @id @default(cuid())
  prospectAccountId String
  title             String
  summary           String
  bodyMarkdown      String
  status            String    @default("DRAFT")
  findingIds        String?   // JSON array of accepted Finding ids (product: CLIENT_ACQUISITION) assembled into this audit
  createdById       String
  createdAt         DateTime  @default(now())
  sentAt            DateTime?

  prospectAccount ProspectAccount @relation(fields: [prospectAccountId], references: [id], onDelete: Cascade)
  createdBy       User            @relation("MicroAuditCreator", fields: [createdById], references: [id])

  @@index([prospectAccountId])
}

model OutreachSequence {
  id                String    @id @default(cuid())
  prospectAccountId String
  contactId         String?
  playbook          String
  state             String    @default("ACTIVE")
  currentStep       Int       @default(0)
  suppressedReason  String?
  createdById       String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  prospectAccount ProspectAccount   @relation(fields: [prospectAccountId], references: [id], onDelete: Cascade)
  contact         ProspectContact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  createdBy       User              @relation("SequenceCreator", fields: [createdById], references: [id])
  messages        OutreachMessage[]

  @@index([prospectAccountId, state])
}

model OutreachMessage {
  id           String    @id @default(cuid())
  sequenceId   String
  stepNumber   Int
  channel      String
  toAddress    String?
  subject      String?
  body         String
  status       String    @default("DRAFT")
  scheduledFor DateTime?
  sentAt       DateTime?
  createdById  String
  createdAt    DateTime  @default(now())

  sequence  OutreachSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  createdBy User             @relation("OutreachMessageCreator", fields: [createdById], references: [id])
  replies   ReplyRecord[]

  @@index([sequenceId, status])
}

model ReplyRecord {
  id                 String   @id @default(cuid())
  outreachMessageId  String?
  contactId          String?
  intent             String?
  extractedJson      String?
  rawBody            String?
  receivedAt         DateTime @default(now())

  outreachMessage OutreachMessage? @relation(fields: [outreachMessageId], references: [id], onDelete: SetNull)
  contact         ProspectContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([outreachMessageId])
}

model SuppressionEntry {
  id        String   @id @default(cuid())
  email     String?  @unique
  domain    String?
  reason    String   @default("OPTED_OUT")
  createdAt DateTime @default(now())

  @@index([domain])
}

// Idempotency ledger for Stripe webhook events — a repeated delivery of the
// same event id must never re-run provisioning.
model StripeWebhookEvent {
  id            String   @id @default(cuid())
  stripeEventId String   @unique
  type          String
  payloadJson   String?
  processedAt   DateTime @default(now())
}
