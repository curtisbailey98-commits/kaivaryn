// ——— 720 SI nine-cycle recursive intelligence (Kaivaryn RR/OE lineage) ———
// Stages R1–R9 = REALITY→…→WITNESS. Only Witness finalizes ZERO_STATE_NEXT.
// Bounded META_RETURN_81 (9×9) → Meta-Invariant; 729 = 9 meta windows max track.

model SiCognitionCycle {
  id               String    @id @default(cuid())
  organizationId   String
  product          String    // REVENUE_RECOVERY | OPERATIONS_EFFICIENCY
  intent           String
  status           String    @default("queued") // queued|running|paused|succeeded|failed|aborted
  currentStage     String    @default("REALITY")
  stageStatus      String    @default("stage_pending")
  nestLevel        Int       @default(0)
  nestLabel        String    @default("I")
  returnIndex      Int       @default(0) // completed R1–R9 count so far
  idempotencyKey   String
  priorZeroStateId String?
  zeroStateId      String?
  invariantId      String?
  methodKey        String?
  methodRole       String?   // champion | challenger | null
  evidencePackUri  String?
  failureCode      String?
  failureDetail    String?
  tokensUsed       Int       @default(0)
  computeMsUsed    Int       @default(0)
  tokensLimit      Int       @default(100000)
  computeMsLimit   Int       @default(300000)
  createdById      String?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stageOutputs SiStageOutput[]
  zeroStates   SiZeroState[]
  invariants   SiCycleInvariant[]
  predictions  SiPrediction[]
  lessons      SiLesson[]
  memories     SiMemoryItem[]
  errors       SiErrorRecord[]

  @@unique([organizationId, product, idempotencyKey])
  @@index([organizationId, product, status])
  @@index([organizationId, product, completedAt])
  @@index([status, currentStage])
}

model SiStageOutput {
  id              String   @id @default(cuid())
  cycleId         String
  organizationId  String
  stage           String   // REALITY…WITNESS | ZERO_RETURN
  returnIndex     Int      // 1–9
  outputJson      String
  evidencePackUri String?
  contentHash     String
  tokensUsed      Int      @default(0)
  computeMs       Int      @default(0)
  createdAt       DateTime @default(now())

  cycle SiCognitionCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@unique([cycleId, stage])
  @@index([organizationId, cycleId])
  @@index([organizationId, stage])
}

model SiZeroState {
  id              String   @id @default(cuid())
  organizationId  String
  product         String
  cycleId         String
  continuityKey   String
  writtenByStage  String   // WITNESS | BOOTSTRAP | RECOVERY — only Witness sets isCanonical for live cycles
  isCanonical     Boolean  @default(false)
  version         Int      @default(1)
  payloadJson     String
  contentHash     String
  priorHash       String?
  evidencePackUri String?
  createdAt       DateTime @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cycle        SiCognitionCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@index([organizationId, product, isCanonical])
  @@index([continuityKey, isCanonical])
  @@index([cycleId])
}

model SiCycleInvariant {
  id              String   @id @default(cuid())
  organizationId  String
  product         String
  cycleId         String
  kind            String   @default("CYCLE_INVARIANT") // CYCLE_INVARIANT | META_INVARIANT
  statement       String
  evidenceJson    String
  contentHash     String
  metaReturnId    String?
  createdAt       DateTime @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cycle        SiCognitionCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@unique([cycleId, kind])
  @@index([organizationId, product, kind])
}

model SiPrediction {
  id              String    @id @default(cuid())
  organizationId  String
  product         String
  cycleId         String
  statement       String
  confidence      Float
  predictedJson   String?
  status          String    @default("open") // open | resolved_positive | resolved_negative | expired
  outcomeJson     String?
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cycle        SiCognitionCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@index([organizationId, product, status])
  @@index([cycleId])
}

model SiLesson {
  id              String   @id @default(cuid())
  organizationId  String
  product         String
  cycleId         String?
  sourceErrorId   String?
  lesson          String
  methodKey       String?
  promoted        Boolean  @default(false)
  evidenceJson    String?
  createdAt       DateTime @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cycle        SiCognitionCycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)

  @@index([organizationId, product, createdAt])
}

model SiMemoryItem {
  id              String   @id @default(cuid())
  organizationId  String
  product         String
  cycleId         String?
  kind            String   // episodic | semantic | temporal | contradiction
  summary         String
  detailJson      String?
  refsJson        String?
  createdAt       DateTime @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cycle        SiCognitionCycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)

  @@index([organizationId, product, kind])
  @@index([organizationId, product, createdAt])
}

model SiMetaReturn {
  id                 String    @id @default(cuid())
  organizationId     String
  product            String
  protocolVersion    String    @default("81") // 81 | 729-track
  windowCycleIdsJson String
  stageHistoryCount  Int       @default(0)
  expectedStageCount Int       @default(81)
  analysisJson       String
  investmentJson     String    @default("{}")
  returnObservedJson String    @default("{}")
  returnRatio        Float?
  status             String    @default("pending_evidence") // pending_evidence | computed | accepted | rejected
  baselineRef        String?
  evidencePackUri    String?
  methodId           String?
  metaInvariantId    String?
  windowIndex        Int       @default(0) // 0–8 toward 729 (9×81)
  idempotencyKey     String
  judgedBy           String?
  acceptedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, product, idempotencyKey])
  @@index([organizationId, product, status])
  @@index([organizationId, product, windowIndex])
}

model SiMethodRegistry {
  id               String    @id @default(cuid())
  organizationId   String
  product          String
  methodKey        String
  role             String    @default("challenger") // champion | challenger | retired
  version          Int       @default(1)
  description      String
  paramsJson       String    @default("{}")
  empiricalJson    String    @default("{}") // sampleSize, successRate, avgDelta, etc.
  status           String    @default("proposed") // proposed | active | deprecated | retired
  validatedAgainst String?   // baseline methodKey or meta return id
  promotedAt       DateTime?
  rolledBackAt     DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, product, methodKey, version])
  @@index([organizationId, product, role, status])
}

model SiErrorRecord {
  id              String   @id @default(cuid())
  organizationId  String
  product         String
  cycleId         String?
  stage           String?
  code            String
  detail          String
  recovered       Boolean  @default(false)
  recoveryJson    String?
  createdAt       DateTime @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cycle        SiCognitionCycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)

  @@index([organizationId, product, createdAt])
  @@index([cycleId])
}

// ——— Kaivaryn Operating Layer (renovated from 720 SI) ———
// Tenant-scoped. Additive only. Every row carries organizationId; every read filters by it.
// Command = SI command hub router; StandingOrder = SI standing orders; Playbook = SI Recipes + Library;
// Run = SI jobs/runbooks run history; Initiative = SI Projects; Briefing = SI recall/digest;
// HealthCheck = SI Operate health ticks / rollups. Deterministic engines — no LLM.

model OpCommand {
  id             String   @id @default(cuid())
  organizationId String
  actorId        String?
  text           String
  route          String // ANALYZE | BUILD | STATUS | ANSWER | DIGEST | RECALL | STANDING | PLAYBOOK | REQUEST | SEARCH | INITIATIVE | HELP
  routeReason    String
  status         String   @default("OK") // OK | ERROR | DENIED
  message        String
  resultJson     String?
  linksJson      String?
  idempotencyKey String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, createdAt])
  @@index([organizationId, route])
}

model OpStandingOrder {
  id             String    @id @default(cuid())
  organizationId String
  title          String
  directive      String
  kind           String // ANALYZE | STATUS | DIGEST | PLAYBOOK
  cadence        String // HOURLY | DAILY | WEEKLY
  enabled        Boolean   @default(true)
  playbookId     String?
  nextRunAt      DateTime?
  lastRunAt      DateTime?
  lastStatus     String? // SUCCEEDED | FAILED
  lastResultJson String?
  runCount       Int       @default(0)
  failureCount   Int       @default(0)
  createdById    String?
  // Prompted automations (additive): original plain-English prompt + parsed spec
  prompt         String?
  scheduleJson   String? // ScheduleSpec — cadence, time, days, day of month
  timezone       String? // IANA zone, default America/New_York
  actionJson     String? // { steps, product, playbookSlug, label }
  conditionJson  String? // optional threshold { metric, op, amount }
  delivery       String? // INBOX (email only when a real mail mechanism exists)
  lastAlertAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, enabled, nextRunAt])
}

/// Platform scheduler ticks (POST /api/operate/tick with OPERATE_TICK_TOKEN). Not tenant data:
/// only counts and timing are stored. tickKey makes retried ticks idempotent.
model OpSchedulerTick {
  id            String    @id @default(cuid())
  tickKey       String    @unique
  source        String    @default("external") // github-actions | external | manual
  status        String    @default("RUNNING") // RUNNING | SUCCEEDED | FAILED
  organizations Int       @default(0)
  ran           Int       @default(0)
  skipped       Int       @default(0)
  error         String?
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?

  @@index([startedAt])
}

model OpPlaybook {
  id             String    @id @default(cuid())
  organizationId String
  slug           String
  name           String
  product        String // REVENUE_RECOVERY | OPERATIONS_EFFICIENCY | BOTH
  category       String    @default("ANALYSIS") // ANALYSIS | GOVERNANCE | BRIEFING | HEALTH
  summary        String
  stepsJson      String // [{ kind: ANALYZE|DETECT|BRIEF|STATUS|TASK, ... }]
  isSystem       Boolean   @default(false)
  runCount       Int       @default(0)
  lastRunAt      DateTime?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, slug])
  @@index([organizationId, product])
}

model OpRun {
  id             String    @id @default(cuid())
  organizationId String
  title          String
  source         String // COMMAND | STANDING_ORDER | PLAYBOOK | MANUAL
  sourceId       String?
  initiativeId   String?
  status         String    @default("QUEUED") // QUEUED | RUNNING | SUCCEEDED | FAILED | WAITING_APPROVAL | CANCELLED
  stepsJson      String    @default("[]")
  currentStep    Int       @default(0)
  evidenceJson   String    @default("[]")
  error          String?
  approvalId     String?
  createdById    String?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
}

model OpInitiative {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String   @default("")
  product        String   @default("BOTH")
  status         String   @default("ACTIVE") // ACTIVE | PAUSED | COMPLETED
  ownerId        String?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  links        OpInitiativeLink[]

  @@index([organizationId, status])
}

model OpInitiativeLink {
  id             String   @id @default(cuid())
  organizationId String
  initiativeId   String
  entityType     String // OPPORTUNITY | INEFFICIENCY | RUN | PLAYBOOK | CYCLE | BRIEFING
  entityId       String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  initiative   OpInitiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)

  @@unique([initiativeId, entityType, entityId])
  @@index([organizationId])
}

model OpBriefing {
  id             String    @id @default(cuid())
  organizationId String
  kind           String // DIGEST | RECALL | STATUS
  title          String
  bodyJson       String
  source         String    @default("COMMAND") // COMMAND | STANDING_ORDER | PLAYBOOK | MANUAL
  createdById    String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

model OpHealthCheck {
  id             String   @id @default(cuid())
  organizationId String
  status         String // OK | DEGRADED | DOWN
  componentsJson String
  source         String   @default("MANUAL") // MANUAL | COMMAND | STANDING_ORDER | TICK
  latencyMs      Int      @default(0)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}
