  decidedBy User?         @relation("FoundryApprovalDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([jobId])
}

model ToolPermissionGrant {
  id            String    @id @default(cuid())
